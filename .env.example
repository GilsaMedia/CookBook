# Copy to .env.local. For local development, `npm run db:env` writes these
# from the running local Supabase stack.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI (server-side only; never NEXT_PUBLIC_). Preferred: your Claude
# subscription through headless Claude Code. Run `claude setup-token` and
# paste the token here. Without it, the Anthropic API key below is used.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Optional: claude-code | anthropic (defaults to claude-code when the token is set)
AI_PROVIDER=
# Optional model names (aliases like sonnet / haiku work with Claude Code)
AI_MODEL_EXTRACT=
AI_MODEL_FAST=

# Picking the cookbook document straight from Google Drive (drive.file scope,
# Google's picker). Both are public browser values: the OAuth client lists
# this site under Authorized JavaScript origins; the API key is restricted to
# this site and the Picker API; Drive and Picker APIs are enabled. Without
# them, the document is uploaded from the device instead.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
