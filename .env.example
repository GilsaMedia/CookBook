# Copy to .env.local. For local development, `npm run db:env` writes these
# from the running local Supabase stack.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI (server-side only; never NEXT_PUBLIC_). Preferred: your Claude
# subscription through headless Claude Code. Run `claude setup-token` and
# paste the token here. Without it, the Anthropic API key below is used.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Optional: claude-code | anthropic (defaults to claude-code when the token is set)
AI_PROVIDER=
# Optional model names (aliases like sonnet / haiku work with Claude Code)
AI_MODEL_EXTRACT=
AI_MODEL_FAST=

# Google sign-in for importing straight from Google Keep (public client ID).
# The OAuth client's project needs the Google Keep API enabled and this site
# under Authorized JavaScript origins. Without it, Keep imports use Takeout.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
