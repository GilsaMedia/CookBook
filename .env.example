# Copy to .env.local. For local development, `npm run db:env` writes these
# from the running local Supabase stack.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI (server-side only; never NEXT_PUBLIC_). Preferred: your Claude
# subscription through headless Claude Code. Run `claude setup-token` and
# paste the token here. Without it, the Anthropic API key below is used.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Optional: claude-code | anthropic (defaults to claude-code when the token is set)
AI_PROVIDER=
# Optional model names (aliases like sonnet / haiku work with Claude Code)
AI_MODEL_EXTRACT=
AI_MODEL_FAST=

# Importing Google Keep without files: Takeout delivers to the user's Drive
# and Google's picker hands the app that file (drive.file scope). Both are
# public browser values. The OAuth client lists this site under Authorized
# JavaScript origins; the API key is restricted to this site and the Picker
# API; Drive API and Picker API are enabled. Without them, Keep uses a ZIP.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
