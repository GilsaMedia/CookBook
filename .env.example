# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# These are the public web-app identifiers (not secrets), but they still stay out of git.
# NEVER put the Anthropic API key here — it lives only in Firebase Secret Manager (ANTHROPIC_API_KEY).

VITE_FIREBASE_API_KEY=
# Use the domain the app is served from (e.g. your-project.web.app) so sign-in
# redirects stay first-party on iPhone/iPad Safari.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local development: set to "true" to use the Firebase emulators (npm run emulators).
# With emulators, the values above can be anything; use project id "demo-cookbook".
VITE_USE_EMULATORS=false
